---
interface Props {
  variant: 'whisk' | 'bowl' | 'spoon';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{variant === 'whisk' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <ellipse cx="32" cy="20" rx="12" ry="16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M26 8c0 10-2 20 6 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
    <path d="M32 6c0 10 0 20 0 30" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
    <path d="M38 8c0 10 2 20-6 28" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
    <path d="M32 36v22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
)}

{variant === 'bowl' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 28h40" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M14 28c0 12 6 20 18 22 12-2 18-10 18-22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M26 28v-6c0-2 2-4 4-2s2 4 4 2 2-4 4-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4" />
    <circle cx="24" cy="36" r="1.5" fill="currentColor" opacity="0.2" />
    <circle cx="34" cy="38" r="1" fill="currentColor" opacity="0.15" />
    <circle cx="40" cy="34" r="1.5" fill="currentColor" opacity="0.2" />
  </svg>
)}

{variant === 'spoon' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <ellipse cx="32" cy="18" rx="10" ry="12" stroke="currentColor" stroke-width="2" />
    <path d="M32 30v26" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <ellipse cx="32" cy="18" rx="6" ry="7" fill="currentColor" opacity="0.1" />
  </svg>
)}
