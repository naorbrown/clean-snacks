---
interface Props {
  variant: 'popcorn' | 'bowl' | 'timer';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;
---

{variant === 'popcorn' && (
  <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M8.5 16l2 13h11l2-13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    <line x1="15.5" y1="16.5" x2="15.5" y2="28.5" stroke="currentColor" stroke-width="1" opacity="0.25" />
    <circle cx="10.5" cy="13" r="3" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
    <circle cx="16" cy="12" r="3.2" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
    <circle cx="21.5" cy="13" r="3" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
    <circle cx="13" cy="8.5" r="2.8" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
    <circle cx="19" cy="8.5" r="2.8" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
    <circle cx="16" cy="5.5" r="2.5" stroke="currentColor" stroke-width="1.5" fill="currentColor" fill-opacity="0.12" />
  </svg>
)}

{variant === 'bowl' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 28h40" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M14 28c0 12 6 20 18 22 12-2 18-10 18-22" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M26 28v-6c0-2 2-4 4-2s2 4 4 2 2-4 4-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4" />
    <circle cx="24" cy="36" r="1.5" fill="currentColor" opacity="0.2" />
    <circle cx="34" cy="38" r="1" fill="currentColor" opacity="0.15" />
    <circle cx="40" cy="34" r="1.5" fill="currentColor" opacity="0.2" />
  </svg>
)}

{variant === 'timer' && (
  <svg class={className} viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="32" cy="36" r="18" stroke="currentColor" stroke-width="2" />
    <path d="M32 24v12l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M26 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    <path d="M32 10v8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
)}
