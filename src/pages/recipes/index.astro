---
import PageLayout from '../../layouts/PageLayout.astro';
import ContentCard from '../../components/ui/ContentCard.astro';
import { getCategories, url } from '../../lib/utils';
import { getCollection } from 'astro:content';

const allRecipes = await getCollection('recipes', ({ data }) => !data.draft);
const sorted = allRecipes.sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = getCategories();
---

<PageLayout title="All Recipes — Clean Snacks" description="Browse all clean snack recipes organized by occasion.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <h1 class="text-3xl sm:text-4xl font-bold text-dark-text mb-4">All Recipes</h1>
    <p class="text-dark-text/60 mb-8">{sorted.length} recipes and counting.</p>

    <!-- Category filter strip -->
    <div class="flex flex-wrap gap-2 mb-10">
      {categories.map((cat) => (
        <a
          href={url(`/categories/${cat.slug}/`)}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm bg-dark-surface hover:bg-dark-elevated text-dark-text/70 hover:text-dark-text no-underline transition-colors"
        >
          <span>{cat.icon}</span>
          <span>{cat.name}</span>
        </a>
      ))}
    </div>

    <!-- Recipe grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sorted.map((recipe) => (
        <ContentCard
          href={url(`/recipes/${recipe.id}/`)}
          title={recipe.data.title}
          description={recipe.data.description}
          category={recipe.data.category}
        />
      ))}
    </div>
  </div>
</PageLayout>
